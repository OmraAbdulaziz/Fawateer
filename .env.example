# Fawateer — environment variables
#
# Copy this file to ".env" in the same folder and replace the fake values.
# ".env" is listed in .gitignore, so real secrets never reach GitHub.
# Docker Compose and all Spring Boot programs read their settings from ".env".

# --- PostgreSQL (database/docker-compose.yml) ---
POSTGRES_USER=fawateer
POSTGRES_PASSWORD=change-me

# --- pgAdmin, the database viewer used in the demo ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me

# --- Fawateer backend ---
# Secret used to sign login tokens (JWT). Use at least 32 random characters.
JWT_SECRET=replace-with-at-least-32-random-characters
# Folder where scanned receipt photos are saved (UC5).
UPLOADS_DIR=./uploads

# --- AI: Gemini through Spring AI ---
# Create a key at https://aistudio.google.com (Get API key).
GEMINI_API_KEY=your-key-from-google-ai-studio
# Use the free Flash model that Google AI Studio lists for your key.
GEMINI_MODEL=gemini-2.5-flash

# --- Hub -> backend (Phase B) ---
# Shared secret the Hub uses to sign receipts. The Hub and the backend use the same value.
HUB_INGEST_SECRET=replace-with-a-long-random-secret

# --- Firebase Cloud Messaging (Phase B, Step 17) ---
# Path to the Firebase service-account JSON file. Never commit that file.
FIREBASE_CREDENTIALS_PATH=C:/path/to/firebase-service-account.json
